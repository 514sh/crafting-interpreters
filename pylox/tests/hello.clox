fun identity(a){
    return a;
}

print identity(add)(1,3);

fun returnFun(){
    var outside = "outside";

    fun inner(){
        print outside;
    }

    return inner;
}

var fn = returnFun();
fn();
x = fn();
y = fn;
x;
y();

class Breakfast{
    init(meat, bread){
        this.meat = meat;
        this.bread = bread;
    }

    serve(who){
        print "Enjoy your breakfast -" + this.meat + ", " + this.bread + ", " + who ;
    }
}

var breakfast = Breakfast("beef", "pandesal");
breakfast.serve("mark");

class Brunch < Breakfast{
    init(bread, meat){
        super.init(bread, meat);
    }

    drink(){
        print "Beer";
    }
}

var brunch = Brunch("chicken", "pan");
brunch.serve("xebec");
brunch.drink();

